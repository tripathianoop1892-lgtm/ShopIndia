NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:5173
# Public backend origin used to build permanent medicine image URLs in production.
# Example: https://api.yourdomain.com
PUBLIC_SERVER_URL=http://localhost:5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
# Optional Atlas SRV fallback settings. Leave blank unless your network requires them.
MONGO_DIRECT_URI=
MONGO_DIRECT_HOSTS=
MONGO_REPLICA_SET=
JWT_SECRET=replace-with-at-least-32-random-characters

# Razorpay test or live credentials (keep the secret server-side only)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Email OTP through SMTP (Gmail app password example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=OmSanjeevani <your-email@example.com>

# SMS OTP through Twilio (E.164 sender number)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15017122661

# Optional prescription-reading integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
